# Optional — the app runs fully without this. Without a key, requirement
# extraction falls back to keyword-line matching, retrieval falls back to
# keyword-overlap scoring, and answer drafting falls back to a
# deterministic evidence-quoting template. Add a key to get real LLM
# extraction, embeddings-based semantic search, and LLM-drafted answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Overrides only — leave unset for normal local dev, which defaults to a
# SQLite file at data/bidfactory.db (see app/db/database.py). Docker Compose
# sets DATABASE_URL to a real Postgres instance automatically; to point
# local dev at Postgres too, uncomment and adjust:
# DATABASE_URL=postgresql+psycopg://bidfactory:bidfactory@localhost:5432/bidfactory
# DATA_DIR=/app/data
